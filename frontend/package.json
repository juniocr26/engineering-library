{
  "name": "engineering-library-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/book-reader.browser.mjs",
    "test:tables": "node tests/table-reader.browser.mjs",
    "test:tables:public": "node tests/table-public.browser.mjs",
    "audit:navigation": "node --experimental-strip-types tools/audit-navigation.ts /tmp/navigation-inventory.json --validate",
    "test:navigation:browser": "node tests/navigation-hierarchy.browser.cjs",
    "test:notes:rich": "node tests/note-rich-content.browser.cjs",
    "test:notes:browser": "node tests/notes.browser.cjs",
    "notes:demos": "node tools/note-demos.cjs",
    "notes:demos:cleanup": "node tools/note-demos.cjs --cleanup",
    "notes:demos:verify": "node tools/verify-note-demos.cjs"
  },
  "dependencies": {
    "decode-named-character-reference": "^1.3.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3"
  }
}
