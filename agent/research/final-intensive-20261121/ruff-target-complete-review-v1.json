    "facts": [
      {
        "evidence_id": "S1",
        "en": "The `resolve_target_version` function resolves the target version of a Rust project by matching the file path against the per-file target version. If no match is found, it returns the unresolved target version. This function is part of the `FormatterSettings` struct.",
        "pt-br": "A fun\u00e7\u00e3o `resolve_target_version` resolve a vers\u00e3o-alvo do projeto Rust ao verificar se o caminho do arquivo coincide com a vers\u00e3o-alvo do arquivo. Se n\u00e3o houver coincid\u00eancia, ela retorna a vers\u00e3o-alvo n\u00e3o resolvida. Essa fun\u00e7\u00e3o faz parte do tipo `FormatterSettings`."
      }
    ],
    "selected_evidence": {
      "S1": {
        "path": "crates/ruff_workspace/src/settings.rs",
        "line": 264,
        "quote": "    pub fn resolve_target_version(&self, path: &Path) -> PythonVersion {\n        self.per_file_target_version\n            .is_match(path)\n            .unwrap_or(self.unresolved_target_version)\n    }\n",
        "complete_unit": true,
        "symbol": "resolve_target_version",
