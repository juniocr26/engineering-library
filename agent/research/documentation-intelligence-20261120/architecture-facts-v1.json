      "source_sha256": "677ca2d9ac94b12aa6befd79de9a52d6c2fc18cf5eb7eec32e6f40a9818f4a8b",
      "first_line": 4,
      "last_line": 11,
      "quote": "def balance_from_payload(account_id: str, payload: Mapping[str, object]) -> Balance:\n    amount = payload[\"available_minor\"]\n    currency = payload[\"currency\"]\n    if type(amount) is not int:\n        raise ValueError(\"available_minor must be an integer\")\n    if not isinstance(currency, str) or len(currency) != 3:\n        raise ValueError(\"currency must have three characters\")\n    return Balance(account_id=account_id, available_minor=amount, currency=currency)\n",
      "quote_sha256": "f8c7c0a583159341cdd574e6eedc4c48efe7a8673e60f94ccfed53627f2e80a3",
      "declared_parameters": [
