{"caller_version":"1.9.43","helper_version":"0.1.4","card":{"path":"httpx/_transports/default.py","line":95,"quote":"@contextlib.contextmanager\ndef map_httpcore_exceptions() -> typing.Iterator[None]:\n    global HTTPCORE_EXC_MAP\n    if len(HTTPCORE_EXC_MAP) == 0:\n        HTTPCORE_EXC_MAP = _load_httpcore_exceptions()\n    try:\n        yield\n    except Exception as exc:\n        mapped_exc = None\n\n        for from_exc, to_exc in HTTPCORE_EXC_MAP.items():\n            if not isinstance(exc, from_exc):\n                continue\n            # We want to map to the most specific exception we can find.\n            # Eg if `exc` is an `httpcore.ReadTimeout`, we want to map to\n            # `httpx.ReadTimeout`, not just `httpx.TimeoutException`.\n            if mapped_exc is None or issubclass(to_exc, mapped_exc):\n                mapped_exc = to_exc\n\n        if mapped_exc is None:  # pragma: no cover\n            raise\n\n        message = str(exc)\n        raise mapped_exc(message) from exc\n","complete_unit":true,"symbol":"map_httpcore_exceptions","enclosing_impl_hint":null,"caught_exception_identifiers":["Exception"],"direct_return_mapping_identifiers":[],"complete_function":true,"preparation":"Python AST range; complete source function, not runtime or dependency verification"},"helper_evidence":{"selector":"map_httpcore_exceptions","declaration_kind":"function","first_line":95,"last_line":118,"quote":"@contextlib.contextmanager\ndef map_httpcore_exceptions() -> typing.Iterator[None]:\n    global HTTPCORE_EXC_MAP\n    if len(HTTPCORE_EXC_MAP) == 0:\n        HTTPCORE_EXC_MAP = _load_httpcore_exceptions()\n    try:\n        yield\n    except Exception as exc:\n        mapped_exc = None\n\n        for from_exc, to_exc in HTTPCORE_EXC_MAP.items():\n            if not isinstance(exc, from_exc):\n                continue\n            # We want to map to the most specific exception we can find.\n            # Eg if `exc` is an `httpcore.ReadTimeout`, we want to map to\n            # `httpx.ReadTimeout`, not just `httpx.TimeoutException`.\n            if mapped_exc is None or issubclass(to_exc, mapped_exc):\n                mapped_exc = to_exc\n\n        if mapped_exc is None:  # pragma: no cover\n            raise\n\n        message = str(exc)\n        raise mapped_exc(message) from exc\n","quote_sha256":"9afd913fa34d8266e68b22d78534c99cb8f9e21afd00df250beecb8ab28404c7","quote_byte_start":2620,"quote_byte_end":3492,"decorated":true,"syntax_only":true,"source_executed":false,"runtime_bindings_verified":false,"limitations":["Complete physical lines include decorators; no decorator, annotation, import, receiver or call binding is evaluated.","Lexical class membership is not proof of a runtime interface or inheritance contract."]},"independent_source_hash_equal":true,"helper_quote_byte_slice_verified":true,"rows":[{"id":"translated-caught-name","status":"REFUSED","reason":"prose omits its selected declaration or method name"},{"id":"correct-caught-name","status":"REFUSED","reason":"prose omits its selected declaration or method name"},{"id":"unknown-qualified-owner","status":"REFUSED","reason":"prose omits its selected declaration or method name"},{"id":"wrong-semantics-same-name","status":"REFUSED","reason":"prose omits its selected declaration or method name"},{"id":"correct-cause","status":"REFUSED","reason":"prose omits its selected declaration or method name"},{"id":"unmapped-evidence-identity","status":"REFUSED","reason":"unknown source evidence ID"}],"source_executed":false,"model_calls":0,"published_files_written":false}
