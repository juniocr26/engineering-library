        "start_line": 284,
        "end_line": 290,
        "quote": "func deflate0(flatCoords []float64, c Coord, stride int) ([]float64, error) {\n\tif len(c) != stride {\n\t\treturn nil, ErrStrideMismatch{Got: len(c), Want: stride}\n\t}\n\tflatCoords = append(flatCoords, c...)\n\treturn flatCoords, nil\n}",
        "declaration": "func deflate0(flatCoords []float64, c Coord, stride int) ([]float64, error)",
        "function_type": "func(flatCoords []float64, c Coord, stride int) ([]float64, error)"
