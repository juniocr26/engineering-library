        "quote": "func inflate0(flatCoords []float64, offset, end, stride int) Coord {\n\tif offset+stride != end {\n\t\tpanic(\"geom: stride mismatch\")\n\t}\n\tc := make([]float64, stride)\n\tcopy(c, flatCoords[offset:end])\n\treturn c\n}",
