s": 0, "parser_python_version": "3.11.2 (main, Oct  7 2026, 12:35:07) [GCC 12.2.0]", "static_compilation_checked": true, "compiler_warnings": [], "source_card": {"path": "inline-packet-module.py", "revision": "source-sha256:3103ecc34bb68362d4fbc0414fb2b40ce946b40848c68287403e1f5a5b4a9656", "sha256": "3103ecc34bb68362d4fbc0414fb2b40ce946b40848c68287403e1f5a5b4a9656"}, "selector": "smart_truncate", "signature": {"positional_only": [], "positional_or_keyword": ["string", "max_length", "word_boundary", "separator", "save_order"], "keyword_only": [], "vararg": null, "kwarg": null, "defaults": {"string": {"kind": "required"}, "max_length": {"kind": "literal", "type": "int", "value": 0}, "word_boundary": {"kind": "literal", "type": "bool", "value": false}, "separator": {"kind": "literal", "type": "str", "value": " "}, "save_order": {"kind": "literal", "type": "bool", "value": false}}, "annotations": {"string": "str", "max_length": "int", "word_boundary": "bool", "separator": "str", "save_order": "bool"}, "return_annotation": "str", "annotation_or_default_executed": false}, "direct_return": {"kind": "outside-direct-return-profile"}, "returned_local_class": null, "direct_nested_functions": {}, "direct_statement_calls": [], "module_written_binding_names": ["CHAR_ENTITY_PATTERN", "DECIMAL_PATTERN", "DEFAULT_SEPARATOR", "DISALLOWED_CHARS_PATTERN", "DISALLOWED_UNICODE_CHARS_PATTERN", "DUPLICATE_DASH_PATTERN", "HEX_PATTERN", "Iterable", "NUMBERS_PATTERN", "QUOTE_PATTERN", "__all__", "annotations", "name2codepoint", "re", "slugify", "smart_truncate", "unicodedata", "unidecode"], "evidence": {"selector": "smart_truncate", "declaration_kind": "function", "first_line": 27, "last_line": 72, "quote": "def smart_truncate(\n    string: str,\n    max_length: int = 0,\n    word_boundary: bool = False,\n    separator: str = \" \",\n    save_order: bool = False,\n) -> str:\n    \"\"\"\n    Truncate a string.\n    :param string (str): string for modification\n    :param max_length (int): output string length\n    :param word_boundary (bool):\n    :param save_order (bool): if True then word order of output string is like input string\n    :param separator (str): separator between words\n    :return:\n    \"\"\"\n\n    string = string.strip(separator)\n\n    if not max_length:\n        return string\n\n    if len(string) < max_length:\n        return string\n\n    if not word_boundary:\n        return string[:max_length].strip(separator)\n\n    if separator not in string:\n        return string[:max_length]\n\n    truncated = ''\n    for word in string.split(separator):\n        if word:\n            next_len = len(truncated) + len(word)\n            if next_len < max_length:\n                truncated += '{}{}'.format(word, separator)\n            elif next_len == max_length:\n                truncated += '{}'.format(word)\n                break\n            else:\n                if save_order:\n                    break\n    if not truncated:  # pragma: no cover\n        truncated = string[:max_length]\n    return truncated.strip(separator)\n", "quote_sha256": "3fee8b13ecef8d92c12d4244ded36bcaffca9274136e38adf79bf59b40151e81", "quote_byte_start": 703, "quote_byte_end": 2010, "decorated": false, "syntax_only": true, "source_executed": false, "runtime_bindings_verified": false, "limitations": ["Complete physical lines include decorators; no decorator, annotation, import, receiver or call binding is evaluated.", "Lexical class membership is not proof of a runtime interface or inheritance contract."]}, "limitations": ["Written signature, return and local-class declarations only; imports/defaults/annotations are not executed.", "Operator-supplied full source and revision, not authenticated origin or current filesystem proof.", "No arbitrary prose entailment, runtime values, inherited methods or helper binding guarantee.", "Missing declarations never authorize REMOVE. Whole-unit quotation bounds are preserved."]}}, "reason": "Compare the positively establish