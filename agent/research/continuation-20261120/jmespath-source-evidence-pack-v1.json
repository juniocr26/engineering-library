      "url": "https://github.com/jmespath/jmespath.py/blob/6ff419a8b171d055a9bfc6904605bceb8b7a80ef/jmespath/parser.py#L105-L116",
      "evidence": {
        "first_line": 105,
        "last_line": 116,
        "quote": "    def _do_parse(self, expression):\n        try:\n            return self._parse(expression)\n        except exceptions.LexerError as e:\n            e.expression = expression\n            raise\n        except exceptions.IncompleteExpressionError as e:\n            e.set_expression(expression)\n            raise\n        except exceptions.ParseError as e:\n            e.expression = expression\n            raise\n",
        "quote_sha256": "143372f69faa7c59bff832aabc1b52d5b59fd3b3243a02daf92a3fafaf863a59",
        "quote_byte_start": 3427,
        "quote_byte_end": 3835,
        "complete_member": true
      }
