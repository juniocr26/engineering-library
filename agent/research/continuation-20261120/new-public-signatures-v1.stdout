[{"id":"totalist-193f647-sync","result":{"status":"WRITTEN_EXPORTED_CALLABLE_FACTS","selector":"default","source_path":"sync.js","source_sha256":"a3dbdaca8cde43f40757f9d6a7ee21f15e41b9e3e3f434b47add306172840e90","source_bytes":414,"source_executed":false,"runtime_bindings_verified":false,"owner_approved":false,"publication_authorized":false,"training_gold":false,"producer":{"version":"0.0.2-research","code_sha256":"126ee7c1ec9ab211bf68817542b41a27c8a81a720fc6cffdf61f39f3b9eb741e","parser_version":"5.9.3","parser_sha256":"3ae902c92cc44dace175c0e69e13a4b0899f6983c6121d76b9ab8dd5795e7675","node_version":"v24.22.0"},"static_node_check":true,"limitations":["Written local ESM export/signature only; package type, build output, imports and actual calls are unverified.","Missing local callable is never retirement evidence. Supplied source is not loaded or executed."],"local_selector":"list","signature":{"parameters":[{"name":"dir","rest":false,"default_expression":null,"default_expression_evaluated":false},{"name":"callback","rest":false,"default_expression":null,"default_expression_evaluated":false},{"name":"pre","rest":false,"default_expression":"''","default_expression_evaluated":false}],"async":false,"generator":false},"evidence":{"first_line":4,"last_line":15,"quote":"export default function list(dir, callback, pre='') {\n\tdir = resolve('.', dir);\n\tlet arr = readdirSync(dir);\n\tlet i=0, abs, stats;\n\tfor (; i < arr.length; i++) {\n\t\tabs = join(dir, arr[i]);\n\t\tstats = statSync(abs);\n\t\tstats.isDirectory()\n\t\t\t? list(abs, callback, join(pre, arr[i]))\n\t\t\t: callback(join(pre, arr[i]), abs, stats);\n\t}\n}\n","quote_sha256":"ffd85aef0fb2e3a7debc1ff1c477fc095abb316222cf03757d164b5b60592dde","complete_unit":true,"quote_byte_start":83,"quote_byte_end":414},"export_evidence":{"kind":"direct-export-in-callable-unit","source_sha256":"a3dbdaca8cde43f40757f9d6a7ee21f15e41b9e3e3f434b47add306172840e90","evidence_ref":"evidence"}}},{"id":"totalist-193f647-async","res