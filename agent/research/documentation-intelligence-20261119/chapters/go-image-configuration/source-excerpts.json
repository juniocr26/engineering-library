          "end_line": 49,
          "quote": "func validatePort(port string) error {\n\tnumber, err := strconv.Atoi(port)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"PORT must be a number: %w\", err)\n\t}\n\n\tif number < 1 || number > 65535 {\n\t\treturn fmt.Errorf(\"PORT must be between 1 and 65535\")\n\t}\n\n\treturn nil\n}",
