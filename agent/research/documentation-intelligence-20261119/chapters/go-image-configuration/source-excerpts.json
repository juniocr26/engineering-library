          "quote": "func main() {\n\tlogger := slog.New(slog.NewTextHandler(os.Stdout, nil))\n\n\tcfg, err := config.Load()\n\tif err != nil {\n\t\tlogger.Error(\"failed to load configuration\", \"error\", err)\n\t\tos.Exit(1)\n\t}\n\n\tserver := httpserver.NewServer(cfg, logger)\n"
