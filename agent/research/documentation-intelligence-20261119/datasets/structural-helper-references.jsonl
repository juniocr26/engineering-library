{"automatic_inference_consumer": false, "automatic_trainer_consumer": false, "category": "STRUCTURAL_RETRIEVAL_REFERENCE_NOT_PROSE_GOLD", "contract_family": "python-contextlib", "evaluation_ref": {"path": "agent/research/documentation-intelligence-20261119/helper-new-families-evaluation.json", "sha256": "ed41d59e2a232403f6190c8605da3877be45bf5d81a8d9cc3be992439aa01428"}, "id": "structural-helper:5", "license_confidentiality_status": "QUARANTINE_PENDING_OWNER_REVIEW", "lineage_group": "source-repository:cpython-stdlib", "observed": {"cumulative_quote_bytes": 2516, "evidence": {"declaration_kind": "function", "decorated": false, "first_line": 515, "last_line": 532, "limitations": ["Complete physical lines include decorators; no decorator, annotation, import, receiver or call binding is evaluated.", "Lexical class membership is not proof of a runtime interface or inheritance contract."], "quote": "    def enter_context(self, cm):\n        \"\"\"Enters the supplied context manager.\n\n        If successful, also pushes its __exit__ method as a callback and\n        returns the result of the __enter__ method.\n        \"\"\"\n        # We look up the special methods on the type to match the with\n        # statement.\n        cls = type(cm)\n        try:\n            _enter = cls.__enter__\n            _exit = cls.__exit__\n        except AttributeError:\n            raise TypeError(f\"'{cls.__module__}.{cls.__qualname__}' object does \"\n                            f\"not support the context manager protocol\") from None\n        result = _enter(cm)\n        self._push_cm_exit(cm, _exit)\n        return result\n", "quote_byte_end": 17462, "quote_byte_start": 16763, "quote_sha256": "216ad93cd4e5dd39bf2bb3569722646742a6f4ee1f5ac082ca247f71abdf4a0e", "runtime_bindings_verified": false, "selector": "_BaseExitStack.enter_context", "source_executed": false, "syntax_only": true}, "extractor_identity": {"implementation_sha256": "e6fd18dea79eb8320c566c816b7aa7bf34d60cbe06b825a67